# Maintainer: Todo Contributors <https://github.com/itsvrushabh/todo>
pkgname=todo-bin
_pkgname=todo
pkgver=0.2.0
pkgrel=1
pkgdesc="High-performance cross-platform Todo app with Web, TUI, CLI, and GUI (pre-built binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/itsvrushabh/todo"
license=('MIT' 'Apache-2.0')
depends=('glibc' 'gcc-libs')
optdepends=(
    'wayland: Wayland display server support for GUI'
    'libx11: X11 display server support for GUI'
    'libxcursor: X11 cursor support for GUI'
    'libxrandr: X11 RandR support for GUI'
    'libxi: X11 Input support for GUI'
    'libxkbcommon: Keyboard support for GUI'
)
provides=('todo')
conflicts=('todo')
source_x86_64=("${pkgname}-${pkgver}-x86_64.tar.gz::https://github.com/itsvrushabh/todo/releases/download/v${pkgver}/todo-linux-amd64.tar.gz")
source_aarch64=("${pkgname}-${pkgver}-aarch64.tar.gz::https://github.com/itsvrushabh/todo/releases/download/v${pkgver}/todo-linux-arm64.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    install -Dm755 "${srcdir}/todo" "${pkgdir}/usr/bin/todo"
}
